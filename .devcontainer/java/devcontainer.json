{
  "name": "HelloMicrosoft - Java",
  "image": "mcr.microsoft.com/devcontainers/java:dev-21-jdk-bookworm",

  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}/Java",

  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack",
        "vscjava.vscode-gradle",
        "ms-azuretools.vscode-docker",
        "pomdtr.excalidraw-editor"
      ],
      "settings": {
        "remote.extensionKind": {
          "pomdtr.excalidraw-editor": ["ui"]
        },
        "editor.formatOnSave": true,
        "java.configuration.updateBuildConfiguration": "automatic"
      }
    }
  },

  "onCreateCommand": "sudo apt-get update && sudo apt-get install -y maven && mvn install -Dmaven.test.failure.ignore=true -f /workspaces/${localWorkspaceFolderBasename}/Java/pom.xml",

  "postCreateCommand": "mvn test -Dmaven.test.failure.ignore=true -f /workspaces/${localWorkspaceFolderBasename}/Java/pom.xml",

  "remoteUser": "vscode"
}