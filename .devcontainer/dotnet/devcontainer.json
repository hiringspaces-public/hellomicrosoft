{
  "name": "HelloMicrosoft - DOTNET",
  "image": "mcr.microsoft.com/devcontainers/dotnet:8.0",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csdevkit",
        "ms-azuretools.vscode-docker",
        "pomdtr.excalidraw-editor"
      ],
      "settings": {
        "remote.extensionKind": {
          "pomdtr.excalidraw-editor": ["ui"]
        },
        "dotnet.server.useOmnisharp": false,
        "dotnet.defaultSolution": "HelloMicrosoft.sln",
        "editor.formatOnSave": true,
        "[csharp]": {
          "editor.defaultFormatter": "ms-dotnettools.csharp"
        }
      }
    }
  },
  "forwardPorts": [5000, 5001],
  "portsAttributes": {
    "5000": { "label": "API — HTTP", "onAutoForward": "notify" },
    "5001": { "label": "API — HTTPS", "onAutoForward": "notify" }
  },
  "postCreateCommand": "dotnet restore && dotnet build",
  "postAttachCommand": "dotnet test",
  "remoteUser": "vscode"
}